<!DOCTYPE html>
<html lang="en">
<meta charset="UTF-8">
<title>Access unavailable</title>
<meta name="viewport" content="width=device-width, initial-scale=1">

<style>
  *{ box-sizing:border-box; }

  html, body{
    margin:0;
    padding:0;
    height:100%;
    font-family:"Segoe UI",system-ui,-apple-system,BlinkMacSystemFont,sans-serif;
    background:#f3f3f3;
  }

  /* Force centering even inside Zoho iframe */
  .viewport-center{
    position:fixed;
    inset:0;
    display:flex;
    align-items:center;
    justify-content:center;
    padding:16px;
    z-index:9999;
    height:70%;
  }

  .card{
    background:#ffffff;
    
    width:100%;
    max-width:420px;
    padding:20px 24px 18px;
    border-radius:8px;
    box-shadow:0 12px 28px rgba(0,0,0,.10);
    text-align:center;
  }

  .card h2{
    margin:0 0 8px;
    font-size:18px;
    font-weight:600;
    color:#111827;
  }

  .card p{
    margin:0 0 4px;
    font-size:13px;
    color:#4b5563;
  }

  .hint{
    margin-top:10px;
    font-size:12px;
    color:#9ca3af;
    line-height:1.5;
  }

  @media (max-width:480px){
    .card{
      max-width:100%;
      padding:18px 16px 16px;
    }
  }
</style>

<body>
  <div class="viewport-center">
    <div class="card">
      <h2>Access unavailable</h2>
      <p>The requested resource could not be found.</p>
      <p class="hint">
        If you reached this page from an email, please close this window and
        open the secure link again directly from the original message.
      </p>
    </div>
  </div>
</body>
</html>
